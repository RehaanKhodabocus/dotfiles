// Inspired by Catnap
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/ml4w/assets/ml4wg", // Path to your logo file
        "type": "auto",                    // 'auto' detects the best protocol for your terminal
        "width": 12,                       // Adjust width (in characters)
        "padding": {
            "top": 1,
            "right": 4,
            "left": 3
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
    {
        "key": "╭───────────╮",
        "type": "custom"
    },
    {
        "key": "│ {#31} user    {#keys}│",
        "type": "title",
        "format": "{user-name}"
    },
    {
        "key": "│ {#32}󰇅 hname   {#keys}│",
        "type": "title",
        "format": "{host-name}"
    },
    {
        "type": "command",
        "key": "│ {#33}󱦟 os age  {#keys}│",
        "keyColor": "magenta",
        "text": "printf \"\\e[0m%s days\\e[0m\" \"$(( ($(date +%s) - $(stat -c %W /)) / 86400 ))\""
    },
    {
        "key": "│ {#34}󰅐 uptime  {#keys}│",
        "type": "uptime"
    },
    {
        "key": "│ {#34}{icon} distro  {#keys}│",
        "type": "os"
    },
    {
        "key": "│ {#35}󰋙 kernel  {#keys}│",
        "type": "kernel"
    },
    {
        "key": "│ {#31}󰾰 host    {#keys}│",
        "type": "host"
    },
    {
        "key": "│ {#32}󰏖 pkgs    {#keys}│",
        "type": "packages"
    },
    {
        "key": "├───────────┤",
        "type": "custom"
    },
    
    {
        "key": "│ {#36}󰇄 desktop {#keys}│",
        "type": "de"
    },
        {
        "key": "│ {#35}󰀻 icons   {#keys}│",
        "type": "icons"
    },
    
    {
        "key": "│ {#31 } term    {#keys}│",
        "type": "terminal"
    },
    {
        "key": "│ {#32}󰧮 termfnt {#keys}│",
        "type": "terminalfont"
    },
    {
        "key": "│ {#33} shell   {#keys}│",
        "type": "shell"
    },
    {
        "key": "│ {#34}󰍹 display {#keys}│",
        "type": "display"
    },
    {
        "key": "├───────────┤",
        "type": "custom"
    },
    {
        "key": "│ {#33}󰍛 cpu     {#keys}│",
        "type": "cpu",
        "showPeCoreCount": true
    },
    {
        "key": "│ {#35}󰢮 gpu     {#keys}│",
        "type": "gpu"
    },
    {
        "key": "│ {#36}󰍛 memory  {#keys}│",
        "type": "memory"
    },
    {
        "key": "│ {#34}󰉉 disk    {#keys}│",
        "type": "disk",
        "folders": "/"
    },
    {
        "key": "├───────────┤",
        "type": "custom"
    },
    
    {
        "key": "│ {#33}󰉼 wmtheme {#keys}│",
        "type": "wmtheme"
    },
    {
        "key": "│ {#34}󰏘 theme   {#keys}│",
        "type": "theme"
    },
    {
        "key": "│ {#39} colors  {#keys}│",
        "type": "colors",
        "symbol": "circle"
    },



    {
        "key": "╰───────────╯",
        "type": "custom"
    }
]}
